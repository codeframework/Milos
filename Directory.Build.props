<Project>
    <PropertyGroup>
		<Version>5.3.3</Version>
		<AssemblyVersion>5.3.3.0</AssemblyVersion>
		<FileVersion>5.3.3.0</FileVersion>
		<LangVersion>Latest</LangVersion>
		<Company>EPS Software Corp.</Company>
		<Authors>EPS Software Corp./Markus Egger Inc.</Authors>
		<Product>CODE Framework: Milos Solution Platform</Product>
		<Copyright>EPS Software Corp.</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>http://www.codeframework.io</PackageProjectUrl>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageTags />
		<PackageIconUrl>https://raw.githubusercontent.com/codeframework/Docs/master/_meta/Milos.png</PackageIconUrl>
		<TargetFramework>netstandard2.0</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>The Milos Solution Platform is the spiritual predecessor of CODE Framework, and some parts of the Milos Solution Platform (especially those important for data access, business logic, and services) are maintained as part of CODE Framework.</Description>
	</PropertyGroup>
</Project>